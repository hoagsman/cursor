# =============================================================================
# NIMBLE TRADING ALGORITHM - MASTER ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# -----------------------------------------------------------------------------
# COINBASE API CREDENTIALS (Advanced Trade API)
# Get these from: https://www.coinbase.com/settings/api
# -----------------------------------------------------------------------------
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# -----------------------------------------------------------------------------
# TRADING CONFIGURATION
# -----------------------------------------------------------------------------
# Initial capital in USDC
INITIAL_CAPITAL=1000.00

# Number of trade groups (4-8 recommended)
NUM_TRADE_GROUPS=4

# Maximum tokens in conversion chain (up to 7)
MAX_CHAIN_LENGTH=7

# Minimum profit threshold after fees (percentage)
MIN_PROFIT_THRESHOLD=0.5

# Coinbase trading fee percentage (maker/taker)
COINBASE_FEE_PERCENT=0.60

# -----------------------------------------------------------------------------
# RISK MANAGEMENT
# -----------------------------------------------------------------------------
# Maximum allocation per trade group (percentage of capital)
MAX_GROUP_ALLOCATION=25

# Stop loss percentage per trade
STOP_LOSS_PERCENT=2.0

# Maximum daily loss before stopping (percentage)
MAX_DAILY_LOSS_PERCENT=5.0

# -----------------------------------------------------------------------------
# EXECUTION SETTINGS
# -----------------------------------------------------------------------------
# Trading mode: 'paper' for simulation, 'live' for real trading
TRADING_MODE=paper

# Order execution timeout (seconds)
ORDER_TIMEOUT=30

# Price slippage tolerance (percentage)
SLIPPAGE_TOLERANCE=0.1

# Retry attempts for failed orders
MAX_RETRY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# LOGGING & DATA
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Excel log file path
EXCEL_LOG_PATH=./logs/trading_log.xlsx

# Enable detailed trade logging
DETAILED_LOGGING=true

# -----------------------------------------------------------------------------
# BACKTESTING
# -----------------------------------------------------------------------------
# Historical data lookback period (days)
BACKTEST_PERIOD_DAYS=30

# Backtesting start date (YYYY-MM-DD)
BACKTEST_START_DATE=2024-11-01

# Backtesting end date (YYYY-MM-DD)
BACKTEST_END_DATE=2024-12-01

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------
# Update interval for price feeds (seconds)
PRICE_UPDATE_INTERVAL=1

# Path recalculation interval (seconds)
PATH_RECALC_INTERVAL=5

# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=10
