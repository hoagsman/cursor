# =============================================================================
# MINIMALLY PRETRAINED CRYPTO ALGORITHM - MASTER ENVIRONMENT FILE
# =============================================================================
# ALC Master Environment Configuration
# Copy to .env and configure with your credentials
# NEVER commit .env to version control

# -----------------------------------------------------------------------------
# COINBASE ADVANCED TRADE API CREDENTIALS
# Get from: https://www.coinbase.com/settings/api
# Required permissions: trade, view
# -----------------------------------------------------------------------------
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# -----------------------------------------------------------------------------
# ACCOUNT CONFIGURATION
# -----------------------------------------------------------------------------
# Maximum account usage (hard cap)
MAX_ACCOUNT_USAGE=1000.00

# Base currency for profit deposits
BASE_CURRENCY=USDC

# -----------------------------------------------------------------------------
# TRADE GROUP CONFIGURATION
# -----------------------------------------------------------------------------
# Number of concurrent trade groups (4-8)
NUM_TRADE_GROUPS=5

# Allocation range per group
MIN_GROUP_ALLOCATION=100.00
MAX_GROUP_ALLOCATION=300.00

# Default allocation (used when probability is neutral)
DEFAULT_GROUP_ALLOCATION=200.00

# -----------------------------------------------------------------------------
# PATH CONFIGURATION
# -----------------------------------------------------------------------------
# Currency chain length (5-10 currencies per path)
MIN_CHAIN_LENGTH=5
MAX_CHAIN_LENGTH=10

# Minimum profit threshold after fees (%)
MIN_PROFIT_THRESHOLD=0.3

# Coinbase fee percentage
COINBASE_FEE_PERCENT=0.60

# -----------------------------------------------------------------------------
# PROBABILITY & ALLOCATION ENGINE
# -----------------------------------------------------------------------------
# High confidence threshold (allocate MAX)
HIGH_CONFIDENCE_THRESHOLD=0.85

# Low confidence threshold (allocate MIN)
LOW_CONFIDENCE_THRESHOLD=0.50

# Probability decay factor for longer chains
CHAIN_LENGTH_DECAY=0.02

# Historical success weight in probability calculation
HISTORICAL_WEIGHT=0.40

# -----------------------------------------------------------------------------
# RISK MANAGEMENT
# -----------------------------------------------------------------------------
# Maximum single trade loss (%)
MAX_SINGLE_LOSS_PERCENT=3.0

# Maximum daily loss before halt (%)
MAX_DAILY_LOSS_PERCENT=5.0

# Circuit breaker: consecutive failures before pause
CIRCUIT_BREAKER_THRESHOLD=5

# Cooldown period after circuit breaker (seconds)
CIRCUIT_BREAKER_COOLDOWN=300

# -----------------------------------------------------------------------------
# EXECUTION SETTINGS
# -----------------------------------------------------------------------------
# Trading mode: 'paper' or 'live'
TRADING_MODE=live

# Order execution timeout (seconds)
ORDER_TIMEOUT=30

# Slippage tolerance (%)
SLIPPAGE_TOLERANCE=0.15

# Max retry attempts per order
MAX_RETRY_ATTEMPTS=3

# Inter-trade delay (ms) - prevents rate limiting
INTER_TRADE_DELAY_MS=100

# -----------------------------------------------------------------------------
# AUDIT & LOGGING
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Audit log path (comprehensive financial audit)
AUDIT_LOG_PATH=./logs/audit

# Trade log Excel path
EXCEL_LOG_PATH=./logs/trading_log.xlsx

# Performance metrics path
METRICS_PATH=./logs/metrics

# Enable detailed execution logging
DETAILED_LOGGING=true

# Audit retention days
AUDIT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# LEARNING & ADAPTATION
# -----------------------------------------------------------------------------
# Enable algorithm learning from results
ENABLE_LEARNING=true

# Learning rate for probability adjustments
LEARNING_RATE=0.05

# Minimum trades before adjusting probabilities
MIN_TRADES_FOR_LEARNING=10

# Path success memory (number of recent trades to consider)
PATH_MEMORY_SIZE=100

# -----------------------------------------------------------------------------
# SCHEDULING
# -----------------------------------------------------------------------------
# Trading start time (24h format, UTC)
TRADING_START_TIME=01:00

# Trading end time (24h format, UTC)  
TRADING_END_TIME=23:00

# Round interval (seconds between trading rounds)
ROUND_INTERVAL=30

# -----------------------------------------------------------------------------
# NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# EMAIL_ALERTS_TO=
